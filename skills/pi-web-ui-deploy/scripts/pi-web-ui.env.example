# ==============================================================================
#  pi-web-ui 自启配置模板（部署为 /scripts/pi-web-ui.env）
#  被 /scripts/start.d/pi-web-ui.sh 读取。
#  注意：本文件刻意放在 start.d 外面 —— start.sh 会把 start.d/* 里每个文件都当
#        脚本执行一遍，放里面会被误执行。
#
#  【重要】本文件是被 `. file` 读入的：里面的值必须 `export` 才会传给服务进程，
#          否则静默不生效（例如 token 会形同虚设）。
# ==============================================================================

# 访问口令。留空/注释 = 不需要口令（任何人拿到地址都能进，谨慎）。
# 要真正启用，必须带 export：
# export PI_WEB_TOKEN="换成你自己的强口令"
# PI_WEB_TOKEN=""

# 托管模式：拒绝「应用内检查更新 / 一键升级 / 插件市场安装」，避免重启后版本被换掉。
# 想恢复应用内升级与插件市场，注释掉这行后重启服务即可。手动 npm i -g 仍可用。
export PI_WEB_MANAGED=1

# 监听地址：0.0.0.0 才能从平台的 8787 代理域名访问；只想本机就改 127.0.0.1
PIWEB_HOST="0.0.0.0"
PIWEB_PORT="8787"

# 工作目录（pi 的 workspace）。若 $HOME 下挂着网盘/同步盘，扫描会偏慢；
# 想更快可以指向某个具体项目目录。
PIWEB_CWD="$HOME"

# 以下为可选项（有默认值，一般不用改）：
# PIWEB_BIN="/usr/local/nodejs/bin/pi-web-ui"
# PIWEB_SCREEN="piweb"
# PIWEB_LOG="/var/log/pi-web.log"
