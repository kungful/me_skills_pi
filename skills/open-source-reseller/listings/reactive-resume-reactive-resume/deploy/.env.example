# 复制为 .env：cp .env.example .env
# 必填三件套（其余都有默认值，先跑通再改）
APP_URL="http://localhost:3000"

# 两处密码必须一致
POSTGRES_PASSWORD="改成你的数据库密码"
DATABASE_URL="postgresql://postgres:改成你的数据库密码@postgres:5432/postgres"

# 生成：openssl rand -hex 32（Windows: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()）
AUTH_SECRET=""

# 可选：自己账号建好之后再加，禁止别人注册（改完 docker compose up -d 生效）
# FLAG_DISABLE_SIGNUPS="true"
