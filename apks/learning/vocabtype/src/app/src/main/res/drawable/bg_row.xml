<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2239FF14" />
            <stroke android:width="1dp" android:color="#8839FF14" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3300F0FF" />
            <stroke android:width="1dp" android:color="#FF00F0FF" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D0D0D18" />
            <stroke android:width="1dp" android:color="#1A00F0FF" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
