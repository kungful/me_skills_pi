<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 局域网设备只跑 http，且地址可任意（默认 192.168.188.254）→ 全局放开明文 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
