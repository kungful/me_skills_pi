<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ======================= 顶栏 ======================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:text="CPE140"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="CONSOLE"
                android:textColor="@color/cyan"
                android:textSize="9sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/pill_state"
                style="@style/Pill"
                android:text="● 未连接" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.25"
            android:text="点右边「连接」开始。设备默认 192.168.188.254"
            android:textColor="@color/dim"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/host"
                style="@style/InputS"
                android:hint="@string/host_hint"
                android:inputType="textUri"
                android:singleLine="true"
                android:text="192.168.188.254"
                android:textColor="@color/cyan"
                android:textSize="12sp" />

            <Button
                android:id="@+id/b_connect"
                style="@style/BtnPri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/connect" />
        </LinearLayout>
    </LinearLayout>

    <!-- ======================= 内容区 ======================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============================= 1 概览 ============================= -->
        <ScrollView
            android:id="@+id/panel1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/CardHi">

                    <TextView
                        style="@style/Sect"
                        android:text="// 设备" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView style="@style/KvKey" android:text="型号" />

                        <TextView
                            android:id="@+id/k_dev"
                            style="@style/KvVal"
                            android:text="—" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView style="@style/KvKey" android:text="固件" />

                        <TextView
                            android:id="@+id/k_fw"
                            style="@style/KvVal"
                            android:text="—" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView style="@style/KvKey" android:text="上游链路" />

                        <TextView
                            android:id="@+id/k_link"
                            style="@style/KvVal"
                            android:textColor="@color/green"
                            android:text="—" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView style="@style/KvKey" android:text="本机 AP" />

                        <TextView
                            android:id="@+id/k_ap"
                            style="@style/KvVal"
                            android:text="—" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/Sect"
                        android:text="// 快捷操作" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_info"
                            style="@style/BtnWide"
                            android:text="设备信息" />

                        <Button
                            android:id="@+id/b_link"
                            style="@style/BtnWide"
                            android:text="链路状态" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_wan"
                            style="@style/BtnWide"
                            android:text="WAN 口" />

                        <Button
                            android:id="@+id/b_lan"
                            style="@style/BtnWide"
                            android:text="LAN 口" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_wifi"
                            style="@style/BtnWide"
                            android:text="无线配置" />

                        <Button
                            android:id="@+id/b_doctor"
                            style="@style/BtnWide"
                            android:text="系统自检" />
                    </LinearLayout>

                    <TextView
                        style="@style/Note"
                        android:layout_marginBottom="0dp"
                        android:layout_marginTop="4dp"
                        android:text="全部走设备的未认证接口，不用登录。结果在下框里。" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/Sect"
                        android:text="// 输出" />

                    <TextView
                        android:id="@+id/out1"
                        style="@style/Out"
                        android:text="点上面按钮看数据。" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ============================= 2 客户端 ============================= -->
        <ScrollView
            android:id="@+id/panel2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/Sect"
                        android:text="// 谁连着这台中继器" />

                    <Button
                        android:id="@+id/b_clients"
                        style="@style/BtnWide"
                        android:layout_marginEnd="0dp"
                        android:text="DHCP 客户端列表" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_arp"
                            style="@style/BtnWide"
                            android:text="ARP 表（在线设备）" />

                        <Button
                            android:id="@+id/b_chan"
                            style="@style/BtnWide"
                            android:text="信道占用" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/b_scan"
                        style="@style/BtnWide"
                        android:layout_marginEnd="0dp"
                        android:text="扫描周边 WiFi（约 10 秒）" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/Sect"
                        android:text="// 输出" />

                    <TextView
                        android:id="@+id/out2"
                        style="@style/Out"
                        android:text="点上面按钮。" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ============================= 3 配置 ============================= -->
        <ScrollView
            android:id="@+id/panel3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/Sect"
                        android:text="// 全量配置（免认证可读）" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_cfgall"
                            style="@style/BtnWide"
                            android:text="读取全部" />

                        <Button
                            android:id="@+id/b_cfgsave"
                            style="@style/BtnWide"
                            android:text="导出为 JSON" />
                    </LinearLayout>

                    <TextView
                        style="@style/Note"
                        android:text="导出的 JSON 里含无线名和口令的十六进制明文，别乱发到网上。" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/Sect"
                        android:text="// 写单个配置项" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/k_key"
                            style="@style/InputS"
                            android:hint="KEY，如 SysDevName"
                            android:singleLine="true" />

                        <EditText
                            android:id="@+id/k_val"
                            style="@style/InputS"
                            android:layout_marginStart="6dp"
                            android:hint="值"
                            android:singleLine="true" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/b_cfgset"
                        style="@style/BtnWide"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="0dp"
                        android:text="写入（会立即生效）" />

                    <TextView
                        style="@style/Note"
                        android:layout_marginBottom="0dp"
                        android:text="无线名 / 口令 / 工作模式这类键会被拦下来二次确认：写错会掉线，最坏要拿网线救。" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/Sect"
                        android:text="// 输出" />

                    <TextView
                        android:id="@+id/out3"
                        style="@style/Out"
                        android:text="—" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ============================= 4 终端 ============================= -->
        <ScrollView
            android:id="@+id/panel4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/Sect"
                        android:text="// 终端 · 以 root 身份执行" />

                    <TextView
                        style="@style/Note"
                        android:text="不用会 Linux 也能用：点下面的「命令手册」，里面每条都写了干了什么；点一下命令就自动填进输入框，再点「运行」就行。本页命令全部在设备上以 root 执行。"

                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_help"
                            style="@style/BtnWide"
                            android:text="? 命令手册 / 教程" />

                        <Button
                            android:id="@+id/b_hist"
                            style="@style/BtnWide"
                            android:text="↑ 上一条" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/Sect"
                        android:text="// 常用命令（点一下直接跑）" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/q1"
                            style="@style/Chip"
                            android:text="我是谁" />

                        <Button
                            android:id="@+id/q2"
                            style="@style/Chip"
                            android:text="进程" />

                        <Button
                            android:id="@+id/q3"
                            style="@style/Chip"
                            android:text="磁盘" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/q4"
                            style="@style/Chip"
                            android:text="网卡与地址" />

                        <Button
                            android:id="@+id/q5"
                            style="@style/Chip"
                            android:text="在线设备" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/q6"
                            style="@style/Chip"
                            android:text="系统日志" />

                        <Button
                            android:id="@+id/q7"
                            style="@style/Chip"
                            android:text="网站目录" />
                    </LinearLayout>

                    <TextView
                        style="@style/Note"
                        android:layout_marginBottom="0dp"
                        android:text="长按 chip 只填入不执行（方便改几个字再跑）。" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/Sect"
                        android:text="// 输入命令" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/cmd"
                            style="@style/InputS"
                            android:hint="例如 uptime"
                            android:imeOptions="actionGo"
                            android:inputType="textNoSuggestions"
                            android:singleLine="true" />

                        <Button
                            android:id="@+id/b_run"
                            style="@style/BtnPri"
                            android:layout_width="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="0dp"
                            android:text="运行" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_clear"
                            style="@style/BtnGhost"
                            android:text="清空输出" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/Sect"
                        android:text="// 输出" />

                    <TextView
                        android:id="@+id/out4"
                        style="@style/Out"
                        android:text="$ 等的就是你的命令。\n提示：先试 uptime（开机多久）、ps w（进程）、df -h（空间）。" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ============================= 5 维护 ============================= -->
        <ScrollView
            android:id="@+id/panel5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/CardHi">

                    <TextView
                        style="@style/Sect"
                        android:text="// 断网诊断 · 分级软修复（先跑这个）" />

                    <TextView
                        style="@style/Note"
                        android:text="断了网别急着重启。点「一键诊断」只读取证，告诉你到底是哪一层坏了：是『假断网』（固件自带门户误判，把 DNS/网页劫到自己页上）、还是上行无线掉了、还是光猫/宽带的问题。判定和依据一起给你。" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_diag"
                            style="@style/BtnPri"
                            android:text="一键诊断" />

                        <Button
                            android:id="@+id/b_fix"
                            style="@style/BtnPri"
                            android:text="立即救网" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_fix_dry"
                            style="@style/Chip"
                            android:text="干跑" />

                        <Button
                            android:id="@+id/b_fix_status"
                            style="@style/Chip"
                            android:text="看状态" />

                        <Button
                            android:id="@+id/b_fix_log"
                            style="@style/Chip"
                            android:text="看日志" />

                        <Button
                            android:id="@+id/b_fix_install"
                            style="@style/Chip"
                            android:text="装软修脚本" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/fixState"
                        style="@style/Out"
                        android:minHeight="0dp"
                        android:text="「立即救网」按六级阶梯从轻到重试：强制重新检测 → 放开被固件禁用的上行 → 重拨 DHCP → 重新关联 → 重起上行接口 → wifi reload；哪一步救回来就停，比重启温和得多。不放心先点「干跑」。" />
                </LinearLayout>

                <LinearLayout style="@style/CardHi">

                    <TextView
                        style="@style/Sect"
                        android:text="// 换新机器 · 一键部署" />

                    <TextView
                        style="@style/Note"
                        android:text="拿到一台同型号的中继器（新机、或刚恢复出厂），点一下把该做的全做了：① 读型号固件 ② 实测注入通道真的能执行（拿 sleep 耗时对比）③ 确认 uid=0 ④ 写入分级软修复 + 断网看门狗 4 个文件 ⑤ 回读 ls -l 核对真落盘了 ⑥ 看当前连通性。默认落到「只记录」模式：cron 挂上但不重启机器，观察两天再说。" />

                    <Button
                        android:id="@+id/b_provision"
                        style="@style/BtnPri"
                        android:layout_width="match_parent"
                        android:layout_weight="0"
                        android:text="一键部署（装软修+看门狗）" />

                    <TextView
                        android:id="@+id/provState"
                        style="@style/Out"
                        android:minHeight="0dp"
                        android:text="不下载整片 flash（8MB）—— 那要救砖的时候单独点「备份整片 flash」。" />
                </LinearLayout>

                <LinearLayout style="@style/CardHi">

                    <TextView
                        style="@style/Sect"
                        android:text="// 断网看门狗 · 自动重启" />

                    <TextView
                        style="@style/Note"
                        android:text="设备上跑的小脚本：每 2 分钟 ping 一次外网；一直不通（默认 10 分钟）就自动重启，把卡死的中继器救回来。开启时会把「分级软修复」也装上，重启前先软修一次 —— 救得回来就不重启。和「定时重启」互不干扰；两次重启至少隔 30 分钟，单次断网最多重启 3 次，之后每 6 小时才试一次，所以不会无限重启。" />

                    <TextView
                        android:id="@+id/guardState"
                        style="@style/Out"
                        android:minHeight="0dp"
                        android:text="还没查过，点「看状态」。" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_g5"
                            style="@style/Chip"
                            android:text="5 分钟" />

                        <Button
                            android:id="@+id/b_g10"
                            style="@style/Chip"
                            android:text="10 分钟" />

                        <Button
                            android:id="@+id/b_g20"
                            style="@style/Chip"
                            android:text="20 分钟" />

                        <EditText
                            android:id="@+id/guardMin"
                            style="@style/InputS"
                            android:layout_weight="0.6"
                            android:gravity="center"
                            android:inputType="number"
                            android:singleLine="true"
                            android:text="10" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_guard_on"
                            style="@style/BtnPri"
                            android:text="开启看门狗" />

                        <Button
                            android:id="@+id/b_guard_off"
                            style="@style/BtnGhost"
                            android:layout_width="0dp"
                            android:layout_weight="0.8"
                            android:text="停用" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_guard_status"
                            style="@style/Chip"
                            android:text="看状态" />

                        <Button
                            android:id="@+id/b_guard_log"
                            style="@style/Chip"
                            android:text="看日志" />

                        <Button
                            android:id="@+id/b_guard_test"
                            style="@style/Chip"
                            android:text="干跑测试" />

                        <Button
                            android:id="@+id/b_guard_uninstall"
                            style="@style/Chip"
                            android:text="卸载" />
                    </LinearLayout>

                    <TextView
                        style="@style/Note"
                        android:layout_marginBottom="0dp"
                        android:text="「干跑测试」只算一遍、告诉你「现在断网的话会做什么」，绝不重启。不放心就先干跑，确认判断对了再开启。" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/Sect"
                        android:text="// 备份与文件" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_dump"
                            style="@style/BtnWide"
                            android:text="备份整片 flash" />

                        <Button
                            android:id="@+id/b_pull"
                            style="@style/BtnWide"
                            android:text="下载设备文件" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_push"
                            style="@style/BtnWide"
                            android:text="上传文件到设备" />

                        <Button
                            android:id="@+id/b_clean"
                            style="@style/BtnWide"
                            android:text="清理临时文件" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_relink"
                            style="@style/BtnWide"
                            android:text="重铺连接通道" />

                        <Button
                            android:id="@+id/b_log"
                            style="@style/BtnWide"
                            android:text="看请求日志" />
                    </LinearLayout>

                    <TextView
                        style="@style/Note"
                        android:layout_marginBottom="0dp"
                        android:text="整片 flash 备份 8MB，是救砖的底牌：哪天刷坏了，用 U-Boot 把备份写回去就能救活。\n\n“重铺连接通道”是干嘛的：工具靠设备上的 /www/.cpeout 这个符号链接把命令输出取回来。设备重启后 /tmp 会被清空，链接就成了断链，读输出会 404 —— 此时点一下它就恢复了（工具自己也会自动重铺，这个按钮是手动的保险）。" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/Sect"
                        android:text="// 设备操作" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_pw"
                            style="@style/BtnWide"
                            android:text="改 Web 口令" />

                        <Button
                            android:id="@+id/b_reboot"
                            style="@style/BtnDanger"
                            android:text="重启" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/b_factory"
                        style="@style/BtnWide"
                        android:layout_marginEnd="0dp"
                        android:text="恢复出厂设置（危险）" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/Sect"
                        android:text="// 定时重启（例如每天凌晨 4 点）" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/KvKey"
                            android:text="启用" />

                        <Switch
                            android:id="@+id/sch_en"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            style="@style/KvKey"
                            android:layout_weight="0.5"
                            android:text="周(0=每天)" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/sch_w"
                            style="@style/InputS"
                            android:gravity="center"
                            android:inputType="number"
                            android:singleLine="true"
                            android:text="0" />

                        <TextView
                            style="@style/KvKey"
                            android:layout_weight="0.4"
                            android:gravity="center"
                            android:text="时" />

                        <EditText
                            android:id="@+id/sch_h"
                            style="@style/InputS"
                            android:gravity="center"
                            android:inputType="number"
                            android:singleLine="true"
                            android:text="4" />

                        <TextView
                            style="@style/KvKey"
                            android:layout_weight="0.4"
                            android:gravity="center"
                            android:text="分" />

                        <EditText
                            android:id="@+id/sch_m"
                            style="@style/InputS"
                            android:gravity="center"
                            android:inputType="number"
                            android:singleLine="true"
                            android:text="0" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/b_read_sch"
                            style="@style/BtnWide"
                            android:text="读当前设置" />

                        <Button
                            android:id="@+id/b_sched"
                            style="@style/BtnWide"
                            android:text="写入设置" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/Sect"
                        android:text="// 输出" />

                    <TextView
                        android:id="@+id/out5"
                        style="@style/Out"
                        android:text="—" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- ======================= 底部导航 ======================= -->
