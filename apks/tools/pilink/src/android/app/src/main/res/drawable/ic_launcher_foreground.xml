<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的前景层（就是 App 在桌面/应用抽屉里显示的那个图标）。

  108×108 画布，安全区是中间 66×66（21..87）。把 24×24 的铃铛放大 3.0 倍再居中：
    · 画出的范围  x 30..78 / y 23.5..80.5  —— 圆形、方形、squircle 遮罩都切不到
    · 铃铛本身又高又窄（16×19），再放大就会被遮罩切边，3.0 是视觉重量和安全区的平衡点
    · 整体上移 1.5 单位，因为铃铛下方的铃舌让视觉重心偏低

  以前直接用 @drawable/ic_pilink 当应用图标：那是一张 24dp 的通知小图，
  ColorOS 会把它缩进一个白圈里，看起来就像"没有图标"。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="3.0"
        android:scaleY="3.0"
        android:translateX="18"
        android:translateY="17.5">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M12,2c-1.1,0 -2,0.9 -2,2v0.6C7.7,5.4 6,7.5 6,10v4l-2,2v1h16v-1l-2,-2v-4c0,-2.5 -1.7,-4.6 -4,-5.4V4c0,-1.1 -0.9,-2 -2,-2z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M10,19a2,2 0 0,0 4,0h-4z" />
    </group>
</vector>
