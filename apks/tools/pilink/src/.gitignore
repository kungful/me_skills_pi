# 依赖与工具下载物不入库
vendor/

# 运行期产物（注意：run-*.bat / fix-*.bat 是启动器，要入库，别加 *.bat）
*.log

# 修复报告里含 pi-web 密码，别提交
*report*.txt

# 本机秘密：local.json（pi-web 密码 + 派发台令牌）生成在 %USERPROFILE%\.pi\android-link\，本来就不在仓库里
local.json

# android/local.properties（含 Android SDK 绝对路径）
android/local.properties
android/.gradle/
android/app/build/

# 注意：分享版的 apk/ 是【要入库/要打包】的 —— 派发台的 /apk 路由靠它分发，
# 所以这里没有排除 apk/。若你不想把二进制提交进版本库，请自行加回 apk/。
